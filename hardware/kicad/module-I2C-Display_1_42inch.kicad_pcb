	(footprint "noknok:noknok_ER-TFT1.42-1_13pin_solder_proto"
		(locked yes)
		(layer "F.Cu")
		(uuid "3b95e9f0-a938-43e8-a127-a892448bb5a1")
		(at 146.78 95 -90)
		(descr "PROTOTYPE-ONLY variant of noknok_ER-TFT1.42-1_13pin_solder with STRETCHED pads (3.5mm long vs 1.7mm finger) to absorb FPC fold/placement error along the tail (~+/-0.9mm slack). Pitch (0.70mm) and count (13) are UNCHANGED and still must match the FPC exactly - only the length is extended. Align the FINGER CENTRE to the PAD CENTRE. Switch back to noknok_ER-TFT1.42-1_13pin_solder (datasheet-exact 2.0mm pads) once the fold geometry is confirmed on a prototype. EastRising ER-TFT1.42-1, 80x160 NV3022B, 4-wire SPI. VERIFY pin-1 side / front-back mirror vs the datasheet outline before ordering.")
		(tags "TFT NV3022B ER-TFT1.42 80x160 IPS FPC noknok proto stretched")
		(property "Reference" "DS1"

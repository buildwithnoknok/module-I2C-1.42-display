	(footprint "noknok:noknok_UART_debug_1x3_pogo"
		(layer "F.Cu")
		(uuid "342c8e33-7682-4781-a88d-2d8d55267aa2")
		(at 134.66 83.4)
		(descr "noknok UART debug pads. 3 single-side SMD pogo pads (1=GND, 2=TX, 3=RX) round 1.5mm on 2.54mm pitch, copper+mask only (NO paste) for a 2.54mm pogo clamp. No mounting hole - unlike the flash pads there is no power-reversal risk, so no anti-reverse key needed (silk + pin-1 marker for orientation). TX=USART1 TX (e.g. CH32V003 PD5), RX=USART1 RX (PD6). Unpopulated/dev-only. Authored on F.Cu - FLIP to bottom for bottom-side access. ENIG finish recommended for repeated pogo contact.")

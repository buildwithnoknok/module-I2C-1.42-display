	(footprint "noknok:noknok_ER-TFT1.42-1_13pin_solder_proto"
		(layer "F.Cu")
		(uuid "3b95e9f0-a938-43e8-a127-a892448bb5a1")
		(at 146.78 95 -90)
		(descr "PROTOTYPE-ONLY variant of noknok_ER-TFT1.42-1_13pin_solder with STRETCHED pads (3.5mm long vs 1.7mm finger) to absorb FPC fold/placement error along the tail (~+/-0.9mm slack). Pitch (0.70mm) and count (13) are UNCHANGED and still must match the FPC exactly - only the length is extended. Align the FINGER CENTRE to the PAD CENTRE. Switch back to noknok_ER-TFT1.42-1_13pin_solder (datasheet-exact 2.0mm pads) once the fold geometry is confirmed on a prototype. EastRising ER-TFT1.42-1, 80x160 NV3022B, 4-wire SPI. PAD ORDER CORRECTED 2026-07-23: pad 1 is on the RIGHT (+X) end. The original release had it reversed and the first fabricated boards came back with the whole row mirrored about pad 7 - dead panel, dead backlight, everything on the wrong pin. Verified against the FPC's printed pin-1/pin-13 labels on real hardware. ALWAYS check the physical FPC labels against this footprint before releasing a board.")
		(tags "TFT NV3022B ER-TFT1.42 80x160 IPS FPC noknok proto stretched")
		(property "Reference" "DS1"
			(at -1.6 -2.82 270)
			(layer "F.SilkS")
			(uuid "9a6b7bac-5e48-4c6f-8732-e17badf7c8d5")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.15)
				)
			)
		)
		(property "Value" "noknok_ER-TFT1.42-1"
			(at 0 3.3 270)
			(layer "F.Fab")
			(hide yes)
			(uuid "359e7436-fc40-48e6-810c-2331b033fdc4")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.15)
				)
			)
		)
		(property "Datasheet" "https://www.buydisplay.com/download/manual/ER-TFT1.42-1_Datasheet.pdf"
			(at 0 0 270)
			(layer "F.Fab")
			(hide yes)
			(uuid "a37dcc30-bc08-4e2c-9b58-eaf97b1453ac")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "1.42in 80x160 IPS TFT, NV3022B controller, 13-pin 0.70mm solder FPC. 4-wire SPI (fixed, no IM strap): SDA=MOSI, SCL=SCK, RS=D/C, RES=reset, CS. Single VCC 2.8-3.3V (internal power). Backlight LEDA/LEDK = 3 parallel LEDs ~3.0V/45-60mA -> needs boost+CC. 80x160 is a window in the NV3022B 132x162 RAM -> set column/row OFFSET in init. Pins 1,2 (touch) + 9 = NC, leave open."
			(at 0 0 270)
			(layer "F.Fab")
			(hide yes)
			(uuid "2bd93d78-9d62-43b3-8e18-d1a41e2544bd")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
